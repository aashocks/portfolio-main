# Copy this file to ".env" and fill in your EmailJS values to enable the contact form.
# Setup steps are in README.md ("Contact form (EmailJS)").
#
# Vite only exposes variables that start with VITE_. These values end up in the
# browser bundle, which is fine: EmailJS public keys are designed to be public.
# Never put a private key or password in a VITE_ variable.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
